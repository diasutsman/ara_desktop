# ==============================================================================
# ARA Assessment - Environment Configuration (.env)
# ==============================================================================

# Application Environment: 'development' or 'production'
APP_ENV=production

# Server Target Mode: 'local' or 'production'
# - local: uses LOCAL_URL_DESKTOP / LOCAL_URL_MOBILE (localhost)
# - production: uses PRODUCTION_URL (https://ara-assessment.com/assess/login)
APP_MODE=production

# True Development Mode: 'true' or 'false'
# When true:
# - Disables aggressive kiosk window hijacking and focus stealing
# - Allows developer browsers (Chrome, Edge, Firefox, Brave), IDEs, DevTools, Task Manager
# - Enables inspectable WebView for remote debugging (chrome://inspect)
# - Enables dev hotkeys: Esc/Ctrl+Q to exit, F12 for supervisor panel, Ctrl+Shift+L to switch server
DEV_MODE=false

# Bypass Window Lockdown: 'true' or 'false'
# Set to 'false' so watchdog timer and app switching detection remain active.
DEV_BYPASS_LOCKDOWN=false

# Record Violations in Dev Mode: 'true' or 'false'
# Set to 'true' so violation detection reports to WebView JS bridge and local backend endpoints.
DEV_RECORD_VIOLATIONS=false

# Target URLs
# Real production URL
PRODUCTION_URL=https://ara-assessment.com/assess/login

# Local testing URLs
# Windows / Desktop localhost URL
LOCAL_URL_DESKTOP=http://localhost/new_ara

# Mobile (Android/iOS) local network URL (IP host workstation)
LOCAL_URL_MOBILE=http://192.168.100.7/new_ara

# Optional direct override URL for all platforms (uncomment if desired)
# LOCAL_URL=http://localhost/new_ara
