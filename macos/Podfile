platform :osx, "10.14"

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'ephemeral', 'Flutter-Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure \"flutter pub get\" is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Flutter-Generated.xcconfig, then run \"flutter pub get\""
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

# Override FlutterMacOS dummy podspec deployment target on Object so CocoaPods TargetDefinition
# inside `target 'Runner' do` generates FlutterMacOS.podspec with s.osx.deployment_target = '10.14'.
Object.send(:define_method, :flutter_install_macos_engine_pod) do |mac_application_path = nil|
  mac_application_path ||= File.dirname(defined_in_file.realpath) if respond_to?(:defined_in_file)
  mac_application_path ||= File.dirname(File.realpath(__FILE__))
  raise 'Could not find macOS application path' unless mac_application_path

  ephemeral_dir = File.join(mac_application_path, 'Flutter', 'ephemeral')
  system('mkdir', '-p', ephemeral_dir)
  copied_podspec_path = File.expand_path('FlutterMacOS.podspec', ephemeral_dir)

  File.open(copied_podspec_path, 'w') do |podspec|
    podspec.write <<~EOF
      #
      # This podspec is NOT to be published. It is only used as a local source!
      # This is a generated file; do not edit or check into version control.
      #

      Pod::Spec.new do |s|
        s.name             = 'FlutterMacOS'
        s.version          = '1.0.0'
        s.summary          = 'A UI toolkit for beautiful and fast apps.'
        s.homepage         = 'https://flutter.dev'
        s.license          = { :type => 'BSD' }
        s.author           = { 'Flutter Dev Team' => 'flutter-dev@googlegroups.com' }
        s.source           = { :git => 'https://github.com/flutter/engine', :tag => s.version.to_s }
        s.osx.deployment_target = '10.14'
        s.vendored_frameworks = 'path/to/nothing'
      end
    EOF
  end

  pod 'FlutterMacOS', path: File.join('Flutter', 'ephemeral')
end

# Normalize plugin podspec and Package.swift minimum OS X versions to 10.14 before CocoaPods/SwiftPM resolves specs.
plugin_spec_patterns = [
  File.join(__dir__, 'Flutter', 'ephemeral', 'Packages', '**', 'Package.swift'),
  File.join(__dir__, 'Flutter', 'ephemeral', 'Packages', '.packages', '**', 'Package.swift'),
  File.join(__dir__, 'Flutter', 'ephemeral', '.symlinks', 'plugins', '*', '**', '*.podspec'),
  File.join(__dir__, 'Flutter', 'ephemeral', '.symlinks', 'plugins', '*', '**', 'Package.swift'),
  File.join(__dir__, '.symlinks', 'plugins', '*', '**', '*.podspec'),
  File.join(__dir__, '.symlinks', 'plugins', '*', '**', 'Package.swift'),
]
Dir.glob(plugin_spec_patterns).each do |spec_file|
  next unless File.file?(spec_file) && File.writable?(spec_file)
  content = File.read(spec_file)
  updated = content
    .gsub(/s\.platform\s*=\s*:osx\s*,\s*['"][0-9.]+['"]/, "s.platform = :osx, '10.14'")
    .gsub(/s\.osx\.deployment_target\s*=\s*['"][0-9.]+['"]/, "s.osx.deployment_target = '10.14'")
    .gsub(/\.macOS\((?:["'][0-9.]+["']|\.v[0-9_]+)\)/, '.macOS("10.14")')
  File.write(spec_file, updated) if updated != content
end

flutter_macos_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_macos_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_macos_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['MACOSX_DEPLOYMENT_TARGET'] = '10.14'
      config.build_settings['ARCHS'] = '$(ARCHS_STANDARD)'
      config.build_settings['ONLY_ACTIVE_ARCH'] = 'NO'
      ldflags = config.build_settings['OTHER_LDFLAGS'] || ['$(inherited)']
      ldflags = [ldflags] if ldflags.is_a?(String)
      ['-Wl,-weak_framework,AuthenticationServices', '-Wl,-weak_framework,SafariServices'].each do |flag|
        ldflags << flag unless ldflags.include?(flag)
      end
      config.build_settings['OTHER_LDFLAGS'] = ldflags
    end
  end
end
